#include <windows.h>
#include "resource.h"

// Application Icons
IDI_LOGO_WHITE  ICON  "..\\SmartTaskbar\\Resources\\Logo-White.ico"
IDI_LOGO_BLACK  ICON  "..\\SmartTaskbar\\Resources\\Logo-Black.ico"

// Manifest
1 24 "daemon.manifest"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "anmolbyte\0"
            VALUE "FileDescription", "SmartTaskbar++ Win32 Background Daemon\0"
            VALUE "FileVersion", "2.0.0.0\0"
            VALUE "InternalName", "SmartTaskbarDaemon\0"
            VALUE "LegalCopyright", "Copyright (c) anmolbyte\0"
            VALUE "OriginalFilename", "SmartTaskbarDaemon.exe\0"
            VALUE "ProductName", "SmartTaskbar++\0"
            VALUE "ProductVersion", "2.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
